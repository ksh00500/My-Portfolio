# Copy to .env and set long unique values. Never commit .env.
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_DB_PASSWORD
DATABASE_URL=postgresql://portfolio:REPLACE_WITH_LONG_RANDOM_DB_PASSWORD@localhost:5432/portfolio
ADMIN_PASSWORD=REPLACE_WITH_LONG_UNIQUE_ADMIN_PASSWORD
SESSION_SECRET=REPLACE_WITH_64_CHARACTER_RANDOM_SECRET
PORT=3000
# Optional: extra origins allowed to call admin APIs, comma-separated (e.g. https://portfolio.example.com).
# Usually unnecessary: the public origin is derived from X-Forwarded-Proto/X-Forwarded-Host.
ALLOWED_ORIGINS=
