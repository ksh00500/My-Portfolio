# Copy to .env; never commit the populated file.
# URL-encode reserved characters in DB password (including @ : / ? # % $ &).
# Existing PostgreSQL 17 container must be reachable by name on portfolio-net.
DATABASE_URL=postgresql://portfolio_admin:REPLACE_WITH_URL_ENCODED_PASSWORD@portfolio-postgres:5432/portfolio
ADMIN_PASSWORD=REPLACE_WITH_LONG_RANDOM_ADMIN_PASSWORD
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ALLOWED_ORIGINS=

# Optional: PostgreSQL 17+ client tools for db:snapshot if not on PATH.
# PG_DUMP_BIN=/absolute/path/to/pg_dump
# PG_RESTORE_BIN=/absolute/path/to/pg_restore
